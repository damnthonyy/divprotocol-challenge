# Le backend NestJS existe : les mocks sont coupes.
# VITE_API_URL reste vide -> le client axios utilise `/api`, relaye vers NestJS
# par le proxy Vite en developpement et par nginx en production.
VITE_API_URL=

VITE_ENABLE_MOCKS=false   # true pour developper le front sans backend

VITE_PUBLIC_BASE_URL=https://mon-sous-domaine.example.com
