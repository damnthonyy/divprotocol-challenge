# Configuration de production.
#
# Copier en `.env.prod` SUR LE SERVEUR et remplacer chaque marqueur REMPLACE_MOI.
# Ce fichier-ci est le seul commite : `.env.prod` ne doit jamais entrer dans git.
#
# `make secrets` genere des valeurs aleatoires solides, pretes a coller.

# --- Domaine -------------------------------------------------------------------
# Ton sous-domaine, sans protocole ni barre finale.
PUBLIC_DOMAIN=REMPLACE_MOI.stage2-div.rayan-drissi.com

# Adresse pour les avis d'expiration de certificat envoyes par Let's Encrypt.
LETSENCRYPT_EMAIL=REMPLACE_MOI@example.com

# --- Images --------------------------------------------------------------------
# Compte GitHub proprietaire du paquet GHCR (en minuscules).
GHCR_OWNER=REMPLACE_MOI
# `latest`, ou un SHA de commit pour epingler un deploiement precis.
IMAGE_TAG=latest

# --- Secrets -------------------------------------------------------------------
# Trois valeurs DIFFERENTES. Ne jamais reutiliser la meme d'une ligne a l'autre :
# JWT_SECRET et DEPOSIT_JWT_SECRET identiques annuleraient la separation entre le
# jeton avocat et le jeton de depot anonyme.
POSTGRES_PASSWORD=REMPLACE_MOI
JWT_SECRET=REMPLACE_MOI_32_CARACTERES_MINIMUM
DEPOSIT_JWT_SECRET=REMPLACE_MOI_32_CARACTERES_MINIMUM_ET_DIFFERENT

# Identifiants racine du stockage objet. Ils servent aussi de cles S3 au backend.
MINIO_ROOT_USER=REMPLACE_MOI
MINIO_ROOT_PASSWORD=REMPLACE_MOI

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REMPLACE_MOI

# --- Reglages ------------------------------------------------------------------
LOG_LEVEL=info

# Le seed est idempotent. Le laisser a `true` garantit qu'un compte de demo existe
# au premier demarrage ; le passer a `false` une fois de vrais comptes crees.
RUN_SEED=true

# HSTS : LAISSER VIDE tant que `make cert-prod` n'a pas reussi.
# Un navigateur ayant vu cet en-tete refuse ensuite tout retour en HTTP, meme
# pour reparer — l'activer trop tot rend le domaine inaccessible pour la duree
# du max-age. `make cert-prod` indique quand le renseigner :
# HSTS_VALUE=max-age=31536000; includeSubDomains
HSTS_VALUE=
